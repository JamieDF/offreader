{
  "name": "OffReader",
  "version": "0.8.0",
  "description": "OffReader — offline ebook reader for Linux desktop",
  "author": {
    "name": "Jamie DF",
    "email": "mail@jamie-fraser.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JamieDF/offreader"
  },
  "license": "MIT",
  "main": "build/src/index.js",
  "scripts": {
    "build": "tsc && electron-rebuild",
    "electron:start-live": "node ./live-runner.js",
    "electron:start": "npm run build && electron --inspect=5858 ./",
    "electron:pack": "npm run build && electron-builder build --dir",
    "electron:make": "npm run build && electron-builder build -p always"
  },
  "dependencies": {
    "@capacitor-community/electron": "^5.0.0",
    "chokidar": "~3.5.3",
    "electron-is-dev": "~2.0.0",
    "electron-serve": "~1.1.0",
    "electron-unhandled": "~4.0.1",
    "electron-updater": "^5.3.0",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "electron-rebuild": "^3.2.9",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "capacitor",
    "electron"
  ],
  "build": {
    "appId": "com.offreader.app",
    "productName": "OffReader",
    "directories": {
      "output": "../dist-electron",
      "buildResources": "resources"
    },
    "files": [
      "assets/**/*",
      "build/**/*",
      "capacitor.config.*",
      "app/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office"
    }
  }
}
